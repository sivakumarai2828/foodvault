# FoodVault backend environment

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
# service_role key — needed only for in-app account deletion (auth admin API)
SUPABASE_SERVICE_KEY=

# OmniRoute is the only AI gateway used by FoodVault.
# Do not configure direct provider keys in this application.
# Use 127.0.0.1 (not localhost) — OmniRoute listens on IPv4 only.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
# Request timeout in seconds. OmniRoute "auto" routing can take 30-40s.
OMNIROUTE_TIMEOUT=120

# Optional logging
LOG_LEVEL=INFO
